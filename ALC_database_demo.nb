Cell[CellGroupData[{

Cell["Step 2: Display and Plot Basic Statistics", "Section",
 CellChangeTimes->{
  3.948336002943439*^9},ExpressionUUID->"6b5d8b13-51a4-4a19-af72-\
e01d28247079"],

Cell[TextData[{
 "In this section, we calculate and display basic statistics for several key \
columns in the dataset:\n- ",
 StyleBox["Number of Patients",
  FontWeight->"Bold"],
 "\n- ",
 StyleBox["Number of Datapoints",
  FontWeight->"Bold"],
 "\n- ",
 StyleBox["Estimated Therapy Duration (in weeks)",
  FontWeight->"Bold"],
 "\n- ",
 StyleBox["Estimated Relative Lymphocyte Count (RLC) at End of Therapy (EoT)",
  
  FontWeight->"Bold"],
 "\n\nFor each variable, we will:\n1. Calculate the ",
 StyleBox["mean, median, and range",
  FontWeight->"Bold"],
 ".\n2. Plot a histogram to visualize the distribution of values."
}], "Text",
 CellChangeTimes->{{3.948336028032262*^9, 
  3.948336061234454*^9}},ExpressionUUID->"5bf48f7b-6cb1-42f9-ab61-\
e69054d42c51"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Helper", " ", "function", " ", "to", " ", "display", " ", "basic", " ", 
    "statistics"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"displayStatistics", "[", 
      RowBox[{"title_", ",", "mean_", ",", "median_", ",", 
       RowBox[{"{", 
        RowBox[{"min_", ",", "max_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<\\n-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-\\n\
\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"title", "<>", "\"\< Statistics:\>\""}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Mean: \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"mean", ",", 
             RowBox[{"{", 
              RowBox[{"Infinity", ",", "2"}], "}"}]}], "]"}], "]"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Median: \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"median", ",", 
             RowBox[{"{", 
