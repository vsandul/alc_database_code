Cell[CellGroupData[{

Cell["Step 3: Load Data from File Paths", "Section",
 CellChangeTimes->{
  3.948337970189652*^9},ExpressionUUID->"6105f0e3-0f4a-435b-aee0-\
e95c00125eac"],

Cell[TextData[{
 "In this step, we will read data from the files specified in the `Relative \
path` column and populate the corresponding cells in the DataFrame.\nEach \
file contains measurements of ",
 Cell[BoxData[
 "x"], "InlineCode",ExpressionUUID->"b06ced15-c53c-4f63-803a-0d53806189bb"],
 ", ",
 Cell[BoxData[
 "y"], "InlineCode",ExpressionUUID->"c9472050-5227-4126-8107-0e0383d4bf6f"],
 ", ",
 Cell[BoxData[
  RowBox[{"x_low", "_err"}]], "InlineCode",ExpressionUUID->
  "ff9abea0-84b7-4a51-bd58-77f93f9b44e7"],
 ", ",
 Cell[BoxData[
  RowBox[{"x_high", "_err"}]], "InlineCode",ExpressionUUID->
  "39846333-6fdd-48e3-834b-ec0f83eb5290"],
 ", ",
 Cell[BoxData[
  RowBox[{"y_low", "_err"}]], "InlineCode",ExpressionUUID->
  "51a88a31-f60b-4391-900d-4a4fb2d785a5"],
 ", and ",
 Cell[BoxData[
  RowBox[{"y_high", "_err"}]], "InlineCode",ExpressionUUID->
  "0e845213-e57e-4a2d-bc20-e17f567c4b62"],
 ". These values will be converted into lists and assigned to the relevant \
columns."
}], "Text",
 CellChangeTimes->{{3.948337980383587*^9, 3.948337989035501*^9}, {
  3.948338840396628*^9, 
  3.948338897631755*^9}},ExpressionUUID->"4bcb0331-a607-4260-9da3-\
ff69826bdb5e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"readData", "[", "filePath_String", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"txt", ",", "lines", ",", "data", ",", "cols"}], "}"}], ",", 
      RowBox[{"Check", "[", 
       RowBox[{"(*", 
        RowBox[{
        "Import", " ", "the", " ", "entire", " ", "file", " ", "as", " ", 
         "text"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"txt", "=", 
          RowBox[{"Import", "[", 
           RowBox[{"filePath", ",", "\"\<Text\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Split", " ", "into", " ", "lines"}], "*)"}], 
         RowBox[{"lines", "=", 
          RowBox[{"StringSplit", "[", 
           RowBox[{"txt", ",", "\"\<\\n\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Drop", " ", "the", " ", "first", " ", "8", " ", "header", " ", 
           "lines", " ", "and", " ", "trim", " ", "each", " ", "remaining", 
           " ", "line"}], "*)"}], 
         RowBox[{"data", "=", 
          RowBox[{"Map", "[", 
           RowBox[{"StringTrim", ",", 
            RowBox[{"Drop", "[", 
             RowBox[{"lines", ",", "8"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"For", " ", "each", " ", "line"}], ",", 
           RowBox[{
           "split", " ", "by", " ", "\"\<;\>\"", " ", "and", " ", "convert", 
            " ", "each", " ", "piece", " ", "to", " ", "a", " ", "number"}]}],
           "*)"}], 
         RowBox[{"data", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToExpression", "/@", 
              RowBox[{"StringSplit", "[", 
               RowBox[{"#", ",", "\"\<;\>\""}], "]"}]}], "&"}], ",", "data"}],
            "]"}]}], ";", "\[IndentingNewLine]", 
