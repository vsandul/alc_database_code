Cell[CellGroupData[{

Cell["GSI ALC Database Demo", "Title",
 CellChangeTimes->{
  3.948297493027082*^9},ExpressionUUID->"24f97ef2-73a6-419f-bf16-\
1544097b89c8"],

Cell[TextData[{
 "Welcome to the ",
 StyleBox["GSI ALC Database Demo-script",
  FontWeight->"Bold"],
 "! This notebook is designed to demonstrate how you can interact with and \
explore the ",
 StyleBox["Absolute Lymphocyte Count (ALC) database",
  FontWeight->"Bold"],
 " developed at ",
 StyleBox["GSI",
  FontWeight->"Bold"],
 ".\n\nPlease note that this is not a rigorous scientific analysis. Instead, \
it serves as a practical demo with sample code to show how you can \
\[OpenCurlyDoubleQuote]play\[CloseCurlyDoubleQuote] with this database and \
extract useful insights."
}], "Text",
 CellChangeTimes->{
  3.948297508266838*^9},ExpressionUUID->"5f28a77f-d1e5-47a4-845f-\
99e5e8979f2a"],

Cell[CellGroupData[{

Cell["Step 1: Load the Dataset", "Section",
 CellChangeTimes->{{3.948297611632394*^9, 
  3.948297619979619*^9}},ExpressionUUID->"c2613f78-1f80-41d2-879a-\
c347a7683ef1"],

Cell[TextData[{
 "We will now read the main dataset (",
 Cell[BoxData[
  RowBox[{"datasets_table", ".", "xlsx"}]], "InlineCode",ExpressionUUID->
  "35cd18bb-4e52-49b1-b03f-854a7f3d466a"],
 ") into a DataFrame using pandas. This dataset contains information about \
multiple publications and related data points."
}], "Text",
 CellChangeTimes->{{3.948297628596696*^9, 
  3.948297653281823*^9}},ExpressionUUID->"32cc60da-b1e9-41ad-bc4a-\
0df937c381f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Import", " ", "the", " ", "Excel", " ", "file", " ", "into", " ", 
    "Mathematica"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"database", "=", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], "<>", 
         "\"\<datasets_table.xlsx\>\""}], ",", "\"\<Data\>\""}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "to", " ", "a", " ", "Dataset", " ", "for", " ", "easier",
      " ", "manipulation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Dataset", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{
          RowBox[{"database", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
       RowBox[{"Rest", "[", "database", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "transformation", " ", "functions", " ", "for", " ", 
     "specific", " ", "columns"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"transforms", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\"\<Dataset ID\>\"", "->", "Round"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Radiation type\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringQ", "[", "#", "]"}], ",", 
            RowBox[{"StringTrim", "/@", 
             RowBox[{"StringSplit", "[", 
              RowBox[{"#", ",", "\"\<,\>\""}], "]"}]}], ",", 
            RowBox[{"{", "}"}]}], "]"}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Therapy modality\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringQ", "[", "#", "]"}], ",", 
            RowBox[{"StringTrim", "/@", 
             RowBox[{"StringSplit", "[", 
              RowBox[{
               RowBox[{"StringReplace", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"\"\<*\>\"", "->", "\"\<\>\""}]}], "]"}], ",", 
               "\"\<,\>\""}], "]"}]}], ",", 
            RowBox[{"{", "}"}]}], "]"}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<# Patients\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StringQ", "[", "#", "]"}], "&&", 
             RowBox[{
              RowBox[{"StringTrim", "[", "#", "]"}], "===", "\"\<\>\""}]}], 
            ",", "Null", ",", 
            RowBox[{"Round", "[", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"StringQ", "[", "#", "]"}], ",", 
               RowBox[{"ToExpression", "[", "#", "]"}], ",", "#"}], "]"}], 
             "]"}]}], "]"}], "&"}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<# Datapoints\>\"", "->", "Round"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Has recovery data\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "===", "\"\<True\>\""}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Normalized\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "===", "\"\<True\>\""}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Combined dataset\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "===", "\"\<True\>\""}], "&"}], ")"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\"\<Estimated EoT Time (wk)\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"StringReplace", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "#", "]"}], ",", 
             RowBox[{"\"\<*\>\"", "->", "\"\<\>\""}]}], "]"}], "]"}], "&"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Estimated RLC at EoT (%)\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ToExpression", "[", 
           RowBox[{"StringReplace", "[", 
            RowBox[{
             RowBox[{"ToString", "[", "#", "]"}], ",", 
             RowBox[{"\"\<*\>\"", "->", "\"\<\>\""}]}], "]"}], "]"}], "&"}], 
         ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Year\>\"", "->", "Round"}], ",", "\[IndentingNewLine]", 
       RowBox[{"\"\<Derived datasets\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"StringQ", "[", "#", "]"}], ",", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s", "=", "#"}], "}"}], ",", 
              RowBox[{"(*", 
               RowBox[{
               "Replace", " ", "parentheses", " ", "and", " ", "fix", " ", 
                "stray", " ", "commas", " ", "before", " ", "closing", " ", 
                "braces"}], "*)"}], 
              RowBox[{
               RowBox[{"s", "=", 
                RowBox[{"StringReplace", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"\"\<(\>\"", "->", "\"\<{\>\""}], ",", 
                    RowBox[{"\"\<)\>\"", "->", "\"\<}\>\""}], ",", 
                    RowBox[{"\"\<,)\>\"", "->", "\"\<}\>\""}]}], "}"}]}], 
                 "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Replace", " ", "an", " ", "empty", " ", "string", " ", 
                 "with", " ", "\"\<Null\>\""}], "*)"}], 
               RowBox[{"s", "=", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"StringTrim", "[", "s", "]"}], "===", "\"\<\>\""}],
                   ",", "\"\<Null\>\"", ",", "s"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"(*", 
                RowBox[{
                "Convert", " ", "the", " ", "string", " ", "to", " ", "an", 
                 " ", "expression", " ", "and", " ", "convert", " ", "reals", 
                 " ", "to", " ", "integers"}], "*)"}], 
               RowBox[{
                RowBox[{"ToExpression", "[", "s", "]"}], "/.", " ", 
                RowBox[{"r_Real", ":>", 
                 RowBox[{"Round", "[", "r", "]"}]}]}]}]}], "]"}], ",", "#"}], 
           "]"}], "&"}], ")"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "the", " ", "transformations", " ", "to", " ", "every", " ",
      "row", " ", "in", " ", "the", " ", "Dataset"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"data", "[", 
      RowBox[{"All", ",", 
       RowBox[{"Function", "[", 
        RowBox[{"row", ",", 
         RowBox[{"AssociationMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"transforms", ",", "#"}], "]"}], ",", 
              RowBox[{
               RowBox[{"transforms", "[", "#", "]"}], "[", 
               RowBox[{"row", "[", "#", "]"}], "]"}], ",", 
              RowBox[{"row", "[", "#", "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"Keys", "[", "row", "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"data", "[", 
      RowBox[{"All", ",", 
       RowBox[{"Function", "[", 
        RowBox[{"row", ",", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{"row", ",", 
           RowBox[{
            RowBox[{"\"\<Derived datasets\>\"", "->", 
             RowBox[{"row", "[", "\"\<Derived datasets\>\"", "]"}]}], "/.", 
            " ", 
            RowBox[{"r_Real", ":>", 
             RowBox[{"Round", "[", "r", "]"}]}]}]}], "]"}]}], "]"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "data", 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.948297698467105*^9, 3.948297751674691*^9}, {
   3.9482978714417887`*^9, 3.948297872602353*^9}, {3.948297929443025*^9, 
   3.948297951020797*^9}, {3.948298016250567*^9, 3.948298043683199*^9}, {
   3.94829881626484*^9, 3.948298850688861*^9}, {3.948298905452003*^9, 
   3.948298907441964*^9}, {3.9482989888551397`*^9, 3.948299168329999*^9}, {
