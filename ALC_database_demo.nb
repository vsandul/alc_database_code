   3.948331630463112*^9}, 3.9483316865197144`*^9, {3.9483317278360863`*^9, 
   3.9483317298194637`*^9}, 3.948331798842153*^9, {3.948331833928001*^9, 
   3.948331834275467*^9}, {3.94833201401707*^9, 3.94833205144893*^9}, {
