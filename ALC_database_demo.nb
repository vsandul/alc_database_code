fd0797afb5ea"],

Cell["\<\
In this step, we will plot all datasets into a single pad. Error bars and \
datasets from Chanana et al., 1976 and Weeke et al., 1970, were omitted for \
better picture.\
\>", "Text",
 CellChangeTimes->{
  3.948339484056246*^9},ExpressionUUID->"3739972d-0fb2-43b5-adf5-\
5948619a9a1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Assume", " ", "dataList", " ", "is", " ", "your", " ", "list", " ", "of",
      " ", "associations"}], ";", 
    RowBox[{"for", " ", 
     RowBox[{"example", ":"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dataList", "=", 
     RowBox[{"Normal", "[", "data", "]"}]}], ";"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"plots", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Chanana76\>\"", ",", "\"\<Weeke70\>\""}], "}"}], 
              ",", 
              RowBox[{"row", "[", "\"\<Publication tag\>\"", "]"}]}], "]"}], "||", 
            RowBox[{
             RowBox[{
              RowBox[{"row", "[", "\"\<y\>\"", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "0"}]}], ",", "Nothing", 
           ",", 
           RowBox[{"(*", 
            RowBox[{
            "Skip", " ", "this", " ", "dataset", " ", "by", " ", "returning", 
             " ", "Nothing"}], "*)"}], 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "x", ",", "y", ",", "xlow", ",", "xhigh", ",", "ylow", ",", 
               "yhigh", ",", "pts", ",", "errGraphics", ",", "dataID"}], 
              "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"dataID", "=", 
               RowBox[{"row", "[", "\"\<Dataset ID\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"pubTag", " ", "=", " ", 
               RowBox[{"row", "[", "\"\<Publication tag\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"dataPath", " ", "=", " ", 
               RowBox[{"row", "[", "\"\<Relative path\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"x", "=", 
               RowBox[{"row", "[", "\"\<x\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"y", "=", 
               RowBox[{"row", "[", "\"\<y\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"xlow", "=", 
               RowBox[{"row", "[", "\"\<x_low_err\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"xhigh", "=", 
               RowBox[{"row", "[", "\"\<x_high_err\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"ylow", "=", 
               RowBox[{"row", "[", "\"\<y_low_err\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"yhigh", "=", 
               RowBox[{"row", "[", "\"\<y_high_err\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Normalize", " ", "y", " ", "and", " ", "its", " ", "error", 
                " ", "arrays", " ", "by", " ", "the", " ", "first", " ", "y", 
                " ", "value"}], "*)"}], 
              RowBox[{"y", "=", 
               RowBox[{"y", "/", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"ylow", "=", 
               RowBox[{"ylow", "/", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"yhigh", "=", 
               RowBox[{"yhigh", "/", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"pts", "=", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"x", ",", "y"}], "}"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{
                "Construct", " ", "error", " ", "bars", " ", "as", " ", 
                 "Graphics", " ", 
                 RowBox[{"primitives", ":", 
