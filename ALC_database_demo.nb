Cell[CellGroupData[{

Cell["Processing Error Values", "Subsubsection",
 CellChangeTimes->{
  3.948338752069296*^9},ExpressionUUID->"4e821029-d42e-416d-93ed-\
df52384efd2b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
 "x_err"], "InlineCode",ExpressionUUID->
  "224137cf-1a40-4ab2-bf72-432b00c9fa16"],
 " and ",
 Cell[BoxData[
 "y_err"], "InlineCode",ExpressionUUID->
  "c3ed4fde-6b4f-4641-9005-d47b6089dd75"],
 " lists represent the positions of the lower and upper error limits. To \
convert them into actual uncertainty values (error magnitudes), we need to \
process them as follows:\n- ",
 Cell[BoxData[
 "x_err"], "InlineCode",ExpressionUUID->
  "d5d02c46-8e9f-4b93-87db-36c40bf7040b"],
 " \[RightArrow] ",
 Cell[BoxData[
  RowBox[{"|", 
   RowBox[{"x", " ", "-", " ", "x_err"}], "|"}]], "InlineCode",ExpressionUUID->
  "52cc4209-9014-437e-8ee7-9b5151beb7ff"],
 "\n- ",
 Cell[BoxData[
 "y_err"], "InlineCode",ExpressionUUID->
  "3a9c8345-c358-4f0d-b3f0-491130a8c675"],
 " \[RightArrow] ",
 Cell[BoxData[
  RowBox[{"|", 
   RowBox[{"y", " ", "-", " ", "y_err"}], "|"}]], "InlineCode",ExpressionUUID->
  "4aee4b5c-d2ff-46fd-ae32-d1d1cf6fe9cf"]
}], "Text",
 CellChangeTimes->{{3.948338768199621*^9, 
  3.948338814974476*^9}},ExpressionUUID->"1e68d11c-610f-4208-99f6-\
123325b5281a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"data", "[", 
    RowBox[{"All", ",", 
     RowBox[{"Function", "[", 
      RowBox[{"row", ",", 
       RowBox[{"row", "~", "Join", "~", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<x_low_err\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"row", "[", "\"\<x\>\"", "]"}], "-", 
             RowBox[{"row", "[", "\"\<x_low_err\>\"", "]"}]}], ")"}]}], ",", 
          RowBox[{"\"\<x_high_err\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"row", "[", "\"\<x_high_err\>\"", "]"}], "-", 
             RowBox[{"row", "[", "\"\<x\>\"", "]"}]}], ")"}]}], ",", 
          RowBox[{"\"\<y_low_err\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"row", "[", "\"\<y\>\"", "]"}], "-", 
             RowBox[{"row", "[", "\"\<y_low_err\>\"", "]"}]}], ")"}]}], ",", 
          RowBox[{"\"\<y_high_err\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"row", "[", "\"\<y_high_err\>\"", "]"}], "-", 
             RowBox[{"row", "[", "\"\<y\>\"", "]"}]}], ")"}]}]}], "|>"}]}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"data", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "[", 
  RowBox[{"[", "\"\<x_low_err\>\"", "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.948339239632169*^9, 3.948339260226194*^9}},
